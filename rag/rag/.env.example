# ══════════════════════════════════════════════════════════════════════════════
# RAG Engine — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai, anthropic, openrouter, ollama
# - openai:     paid API (any OpenAI-compatible server works via OPENAI_BASE_URL)
# - anthropic:  paid API (Claude)
# - openrouter: one key for many models; free-tier models available
# - ollama:     free, local, no API key needed
# The team default is GLM 5.3 Flash on OpenRouter: paste your key below and nothing else changes.
# With no key the app still runs; the copilot then writes template answers (scores are the same).
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI / Compatible (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings ───────────────────────────────────────────────────────────────
# bge-small (BAAI/bge-small-en-v1.5) — local, free
EMBEDDING_MODEL=bge-small
EMBEDDING_DEVICE=cpu

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE=faiss
FAISS_INDEX_DIR=./data/faiss_index

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=128
MIN_CHUNK_LENGTH=10

# ── Retrieval ────────────────────────────────────────────────────────────────
SIMILARITY_TOP_K=10
HYBRID_TOP_K=10
SCORE_THRESHOLD=0.3
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_ANSWER_VALIDATION=true
MAX_CONTEXT_TOKENS=3000

# ── Cost tracking (USD per 1k tokens; ollama is always 0) ───────────────────
OPENAI_COST_PER_1K_INPUT_TOKENS=0.005
OPENAI_COST_PER_1K_OUTPUT_TOKENS=0.015
ANTHROPIC_COST_PER_1K_INPUT_TOKENS=0.003
ANTHROPIC_COST_PER_1K_OUTPUT_TOKENS=0.015
OPENROUTER_COST_PER_1K_INPUT_TOKENS=0.0
OPENROUTER_COST_PER_1K_OUTPUT_TOKENS=0.0

# ── Ingestion ────────────────────────────────────────────────────────────────
ENABLE_OCR=false
OCR_LANGUAGE=eng
CSV_BATCH_SIZE=500
JSON_BATCH_SIZE=500

# ── Chat / Memory ────────────────────────────────────────────────────────────
ENABLE_MEMORY=true
MEMORY_WINDOW=10

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Authentication ───────────────────────────────────────────────────────────
ENABLE_AUTH=false
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
# Local, one instance: SQLite file (default).
DATABASE_URL=sqlite:///./data/rag.db
# Production: PostgreSQL, shared by every instance. postgres:// URLs work too.
# DATABASE_URL=postgresql+psycopg://rag:your-password@localhost:5432/rag

# docker compose runs PostgreSQL and sets DATABASE_URL for the API from these.
# Use letters and digits in the password: it is placed inside a URL.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=rag

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Retail Operations Copilot (Use Case 3) ──────────────────────────────────
# The LLM above writes the copilot's answers; every scored decision is rule-based.
COPILOT_DIR=./usecase3
COPILOT_USE_LLM=true
# Empty = the provider's model setting above (GLM 5.3 Flash on OpenRouter). Set it only to give
# the copilot a different model from the same provider; a model of another provider fails.
COPILOT_LLM_MODEL=
# OpenRouter only: low reasoning keeps GLM answers at about 1-3 s.
COPILOT_LLM_REASONING_EFFORT=low
COPILOT_LLM_TRIAGE=false
# Ask the LLM whether a message is a prompt injection or asks for restricted data.
# It can only add a refusal, never remove one. One extra call per question.
COPILOT_LLM_GUARD=false
COPILOT_LLM_TIMEOUT_SECONDS=60
COPILOT_LLM_MAX_RETRIES=1
COPILOT_LLM_MAX_TOKENS=6000
COPILOT_USE_EMBEDDINGS=true
# Fix typos and Hinglish, and match messages by meaning to past tickets and to examples of
# each P1 trigger and restricted request. Can only raise a priority or add a refusal.
COPILOT_SEMANTIC_TRIAGE=true
COPILOT_ANCHOR_TS=2026-10-10 12:00:00
COPILOT_CONFIDENCE_THRESHOLD=0.60
